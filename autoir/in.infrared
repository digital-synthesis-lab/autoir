# ----------------- Init Section -----------------
include header.in

timestep        0.5
thermo          200

variable T equal 300
variable P equal 1
variable sFreq equal 1

compute         1 all dipole
variable        mu_x equal c_1[1]
variable        mu_y equal c_1[2]
variable        mu_z equal c_1[3]
variable        tt equal time

# Equilibration
velocity        all create ${T} 38564 rot yes mom yes
#fix             f1 all npt temp ${T} ${T} 100.0 iso ${P} ${P} 1000.0
fix             f1 all nvt temp ${T} ${T} 100.0
run             50000

fix             p1 all print ${sFreq} "${tt},${mu_x},${mu_y},${mu_z}" screen no file dipoles.csv

# Production run
dump d1 all atom 1000 dump.lammpstrj
run             100000

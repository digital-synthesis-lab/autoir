include header.in

timestep        0.25
neighbor        3.0 multi

thermo          200
thermo_style custom step temp pe etotal press vol

variable T equal {{ job.temperature }}
{% if job.pressure is not none %}
variable P equal {{ job.pressure }}
{% endif %}
variable sFreq equal 1

compute         1 all dipole
variable        mu_x equal c_1[1]
variable        mu_y equal c_1[2]
variable        mu_z equal c_1[3]
variable        tt equal time

# Equilibration
velocity        all create ${T} {{ job.seed }} rot yes mom yes
{% if job.pressure is not none %}
fix             f1 all npt temp ${T} ${T} $(100*dt) iso ${P} ${P} $(1000*dt)
{% else %}
fix             f1 all nvt temp ${T} ${T} $(100*dt)
{% endif %}
run             {{ job.equi_steps }}

fix             p1 all print ${sFreq} "${tt},${mu_x},${mu_y},${mu_z}" screen no file dipoles.csv

# Production run
{% if job.dump_freq is not none %}
dump d1 all atom {{ job.dump_freq }} dump.lammpstrj
{% endif %}

run             {{ job.prod_steps }}
